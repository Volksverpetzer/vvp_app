{
  "name": "vvp_app",
  "version": "2.5.6",
  "versionCode": 2611051,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "@stripe/stripe-react-native"
      ]
    }
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.x"
